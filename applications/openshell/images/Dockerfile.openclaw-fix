# Fix /sandbox permissions for OpenShell workspace seeding.
#
# openshell-sandbox seed-workspace (the workspace-init init container) copies
# the image workdir (/sandbox) to the workspace PVC as the pod's runAsUser
# (1000860000 via the OpenShift restricted SCC). This base image ships:
#   /sandbox          770  1000:root   (others: no access)
#   /sandbox/.openclaw 700  1000:sandbox (others: no access)
# so the seed fails with exit 1 and no output ("Init:Error"), and the
# supervisor then dies with "discover workload image policy: boundary
# unavailable ... timed out while waiting for remote boundary boot".
#
# chmod -R a+rX adds read (and traverse) for group+others without weakening
# write perms, matching the community sandboxes/base image (755).
#
# ALSO: this image sets TMPDIR/SQLITE_TMPDIR=/sandbox/.openclaw/state. The
# OpenShell runtime resolves its temp dir from TMPDIR at bootstrap, and
# /sandbox/.openclaw/state in the seeded PVC is not writable by the pod UID at
# that point — so the Landlock probe ("create Landlock probe root") fails with
# EACCES and the runtime dies instantly, before the boundary opens. Point both
# at /tmp (world-writable, 1777), which the community sandboxes/base image
# proves works with the default policy.
#
# ALSO (0.1.3): the aipcc base image's default CMD is `openclaw` (bare), which
# does not run the gateway. The dashboard's Create sandbox modal cannot
# override the CMD, so UI-provisioned sandboxes ran `openclaw` bare, the agent
# crashed right after the workspace seed, and the gateway's provisioning
# repair window (OPENSHELL_PROVISIONING_REPAIR_WINDOW_MS) expired and
# reclaimed the sandbox ("Pod has been terminated"). Bake the main-process
# command the CLI create uses (openshell sandbox create ... -- sh -c
# 'openclaw onboard ...; exec openclaw gateway run') as the image CMD: the
# gateway resolves the main process from the image config when no command
# override is given, and an explicit CLI -- override still takes precedence.
# Build:  podman build -f Dockerfile.openclaw-fix -t quay.io/eformat/openshell-openclaw:0.1.3 .
# Push:   podman push quay.io/eformat/openshell-openclaw:0.1.3  (make public)
# Use as the sandbox workload image in the dashboard's Create sandbox modal.
FROM quay.io/aipcc/base-images/agentic/openclaw@sha256:896d1526ee29b53167034ba65d1c758c8da777f441ed094e19f3bcf6d7445c61
USER root
RUN chmod -R a+rX /sandbox
USER sandbox:sandbox
ENV TMPDIR=/tmp
ENV SQLITE_TMPDIR=/tmp
CMD ["sh", "-c", "openclaw onboard --non-interactive --accept-risk --skip-health || true; exec openclaw gateway run"]
