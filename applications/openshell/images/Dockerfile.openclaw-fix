# Fix /sandbox permissions for OpenShell workspace seeding.
#
# openshell-sandbox seed-workspace (the workspace-init init container) copies
# the image workdir (/sandbox) to the workspace PVC as the pod's runAsUser
# (1000860000 via the OpenShift restricted SCC). This base image ships:
#   /sandbox          770  1000:root   (others: no access)
#   /sandbox/.openclaw 700  1000:sandbox (others: no access)
# so the seed fails with exit 1 and no output ("Init:Error"), and the
# supervisor then dies with "discover workload image policy: boundary
# unavailable ... timed out while waiting for remote boundary boot".
#
# chmod -R a+rX adds read (and traverse) for group+others without weakening
# write perms, matching the community sandboxes/base image (755).
#
# ALSO: this image sets TMPDIR/SQLITE_TMPDIR=/sandbox/.openclaw/state. The
# OpenShell runtime resolves its temp dir from TMPDIR at bootstrap, and
# /sandbox/.openclaw/state in the seeded PVC is not writable by the pod UID at
# that point — so the Landlock probe ("create Landlock probe root") fails with
# EACCES and the runtime dies instantly, before the boundary opens. Point both
# at /tmp (world-writable, 1777), which the community sandboxes/base image
# proves works with the default policy.
#
# ALSO (0.1.3): the aipcc base image's default CMD is `openclaw` (bare), which
# does not run the gateway. NOTE: the baked CMD below is NOT used as the
# sandbox main process — OpenShell replaces the pod command with the
# supervisor runtime, and the main process comes only from the CreateSandbox
# command override. An empty override resolves to a login shell (`bash -l`,
# openshell-sandbox resolve_agent_spec), never the image CMD/Entrypoint.
#
# (0.1.4) START SCRIPT: because the empty-override main process is a login
# shell, /etc/profile.d/openshell-openclaw.sh (copied from
# openclaw-profile.sh) starts the openclaw gateway when any login shell
# sources it — the canonical main process included. This makes the dashboard's
# Create sandbox modal work with no command override: the UI-provisioned
# sandbox runs `bash -l`, the profile starts openclaw, and the gateway's
# service relay to 127.0.0.1:18789 succeeds. The script is guarded (pidfile)
# so exec/TUI sessions never start a second gateway.
#
# (0.1.5) TRUSTED PROXIES AUTO-PATCH: the profile script also patches
# gateway.trustedProxies=["127.0.0.1","::1"] into the workspace openclaw.json
# after onboard (only when absent — manual customization wins). Without it
# the dashboard URL fails with "Proxy client attribution is required": the
# service relay (OpenShift router -> gateway -> supervisor relay) arrives at
# openclaw via a loopback peer, and openclaw rejects forwarded headers from
# untrusted peers. Onboard does NOT set this and openclaw never writes it —
# verified in-image (audit findings only recommend it). Provenance of the
# working reference value: a manual node one-liner edit on the first working
# sandbox, same value.
# Build:  podman build -f Dockerfile.openclaw-fix -t quay.io/eformat/openshell-openclaw:0.1.5 .
# Push:   podman push quay.io/eformat/openshell-openclaw:0.1.5  (make public)
# Use as the sandbox workload image in the dashboard's Create sandbox modal
# (0.1.5+), or via the CLI with an explicit `--` command override (either
# works). The CMD below is kept for direct container runs (podman/docker).
FROM quay.io/aipcc/base-images/agentic/openclaw@sha256:896d1526ee29b53167034ba65d1c758c8da777f441ed094e19f3bcf6d7445c61
USER root
RUN chmod -R a+rX /sandbox
COPY openclaw-profile.sh /etc/profile.d/openshell-openclaw.sh
RUN chmod 0644 /etc/profile.d/openshell-openclaw.sh
USER sandbox:sandbox
ENV TMPDIR=/tmp
ENV SQLITE_TMPDIR=/tmp
CMD ["sh", "-c", "openclaw onboard --non-interactive --accept-risk --skip-health || true; exec openclaw gateway run"]
